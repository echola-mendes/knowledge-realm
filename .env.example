# 复制为 .env 后填写。不要把 .env 提交到 git。
# LLM / Embedding 使用阿里云 DashScope 兼容模式，不需要 OpenAI 账号。

# 本机 Postgres（库名 echola_kb）。密码写在本文件，勿提交。
# 必须是「用户名:密码」。用户名一般是 postgres，不要只写密码。
# 正确示例：postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/echola_kb
DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/echola_kb

# DashScope API Key
LLM_API_KEY=
# 兼容模式地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 可与 LLM 使用同一 Key 与 Base URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 v3。同维可改为 text-embedding-v4 或 qwen3.7-text-embedding（仍 1024，须全量 reindex）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 原件与解析稿根目录（相对仓库根或绝对路径）
DATA_DIR=data

# Session 签名（至少 32 字符）。不要提交真实值。
SESSION_SECRET=please-replace-with-a-long-random-string
# 空库创建的初始用户名；密码只写在本机 .env，应用内哈希存储
INITIAL_USERNAME=echola
INITIAL_PASSWORD=

# P2 关键词 BM25（本机 Elasticsearch）。未配则 Hybrid 关键词路不可用。
# ELASTICSEARCH_URL=http://127.0.0.1:9200

# P2 Rerank。完整路径可写到 /rerank 或 /reranks；否则默认补 /reranks。
# Jina 免费额度示例：
# RERANK_BASE_URL=https://api.jina.ai/v1/rerank
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_API_KEY=  # jina.ai 控制台 Key，不是百炼
# 硅基：完整路径 /rerank（不要用百炼 Key）
# RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# P2 相关性：Rerank/RRF 后逐条低于此分则丢弃。默认 0.5，可按模型调。
# RELEVANCE_MIN_SCORE=0.5

# P2 Agent web_search（httpx POST JSON {"query": "..."}，期望 results/items/data）。未配则 WEB 得到空列表。禁止 Playwright。
# WEB_SEARCH_URL=
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT=10


# ---- P4 出行 Agent（TRAVEL-PLAN-1）----
# 飞猪 flyai skill CLI（免 Key trial 可用；配 Key 提升配额）
FLYAI_CLI=flyai
FLYAI_API_KEY=
FLYAI_TIMEOUT=20
# 酒店源：留空=占位提示（不伪造房型）；flyai=走 flyai search-hotel
HOTEL_SOURCE=
# MinIO（软依赖；方案页 plans/ 与知识报告 reports/ 回看。留空=仅实时展示）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=zhiyu
MINIO_SECURE=

# 定时任务队列（arq Worker）
REDIS_URL=redis://127.0.0.1:6379/0

# AI 资讯数据源（默认 server/config/news_sources.yaml）
# NEWS_SOURCES_PATH=server/config/news_sources.yaml
# NEWS_TOP_K=20
# NEWS_MAX_ITEMS=30
# NEWS_HTTP_TIMEOUT=10
# NEWS_LLM_TIMEOUT=60

