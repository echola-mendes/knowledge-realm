# 复制为 .env 后填写。不要把 .env 提交到 git。
# LLM / Embedding 使用阿里云 DashScope 兼容模式，不需要 OpenAI 账号。

# 本机 Postgres（库名 echola_kb）。密码写在本文件，勿提交。
# 必须是「用户名:密码」。用户名一般是 postgres，不要只写密码。
# 正确示例：postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/echola_kb
DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/echola_kb

# DashScope API Key
LLM_API_KEY=
# 兼容模式地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 可与 LLM 使用同一 Key 与 Base URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 v3；百炼额度用尽或提示 v3 不可用时改为 text-embedding-v4（维数仍 1024 则不必改下一列）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 原件与解析稿根目录（相对仓库根或绝对路径）
DATA_DIR=data
